{
  "applicationId": "com.cibernetdocs.formatter",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": false,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "window.*",
    "storage.*",
    "events.*",
    "debug.log"
  ],
  "globalVariables": {},
  "modes": {
    "window": {
      "title": "CibernetDocs",
      "width": 1440,
      "height": 900,
      "minWidth": 960,
      "minHeight": 600,
      "center": true,
      "resizable": true,
      "useSavedState": true,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": false,
      "exitProcessOnClose": true,
      "emitDropEvents": true
    }
  },
  "cli": {
    "binaryName": "cibernetdocs",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "extensionsExclude": ["node_modules"],
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  },
  "applicationName": "CibernetDocs",
  "author": "CibernetDocs",
  "description": "Markdown to formal PDF document formatter (self-contained desktop app)",
  "copyright": "Copyright © 2026 CibernetDocs",
  "applicationIcon": "buildAssets/appIcon.png"
}
